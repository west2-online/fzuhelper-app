<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:id="@+id/next_class_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:clipChildren="false"
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/course_widget_background"
        android:paddingStart="@dimen/course_widget_padding_horizontal"
        android:paddingEnd="@dimen/course_widget_padding_horizontal"
        android:paddingTop="@dimen/course_widget_padding_vertical"
        android:paddingBottom="@dimen/course_widget_padding_vertical"
        android:orientation="vertical">
        <LinearLayout
            android:clipChildren="false"
            android:id="@+id/widget_days"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal" />
    </LinearLayout>
</LinearLayout>
