<manifest xmlns:android="http://schemas.android.com/apk/res/android"
        package="com.west2online.nativewidget">

        <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

        <application>
            <activity android:name="com.helper.west2ol.fzuhelper.NextClassWidgetConfigurationActivity"
                android:exported="true">
                <intent-filter>
                    <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE"/>
                </intent-filter>
            </activity>
            <activity android:name="com.helper.west2ol.fzuhelper.CourseScheduleWidgetConfigurationActivity"
                android:exported="true">
                <intent-filter>
                    <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE"/>
                </intent-filter>
            </activity>
            <receiver
                android:name="com.helper.west2ol.fzuhelper.NextClassWidgetProvider"
                android:exported="true"
                android:label="@string/next_class_widget_description">
                <intent-filter>
                    <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                </intent-filter>
                <meta-data
                    android:name="android.appwidget.provider"
                    android:resource="@xml/next_class_widget_provider" />
            </receiver>
            <receiver
                android:name="com.helper.west2ol.fzuhelper.CourseOverviewWidgetProvider"
                android:exported="true"
                android:label="@string/course_overview_widget_description">
                <intent-filter>
                    <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                </intent-filter>
                <meta-data
                    android:name="android.appwidget.provider"
                    android:resource="@xml/course_overview_widget_provider" />
            </receiver>
            <receiver
                android:name="com.helper.west2ol.fzuhelper.CourseWidgetUpdateReceiver"
                android:exported="false">
                <intent-filter>
                    <action android:name="android.intent.action.BOOT_COMPLETED" />
                    <action android:name="android.intent.action.TIME_SET" />
                    <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                    <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                </intent-filter>
            </receiver>
            <receiver
                android:name="com.helper.west2ol.fzuhelper.CourseScheduleWidgetProvider"
                android:exported="true"
                android:label="@string/course_schedule_widget_description">
                <intent-filter>
                    <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                </intent-filter>

                <meta-data
                    android:name="android.appwidget.provider"
                    android:resource="@xml/course_schedule_widget_provider" />
            </receiver>

            <service
                android:name="com.helper.west2ol.fzuhelper.CourseScheduleWidgetService"
                android:exported="false"
                android:permission="android.permission.BIND_REMOTEVIEWS" />

            <service
                android:name="com.helper.west2ol.fzuhelper.QRCodeQSTileService"
                android:exported="true"
                android:label="@string/qrcode_qs_tile_label"
                android:icon="@drawable/ic_qrcode"
                android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
                <intent-filter>
                    <action android:name="android.service.quicksettings.action.QS_TILE" />
                </intent-filter>
            </service>

        </application>

</manifest>
